{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3-coordinator.dev/process-definition.json",
  "title": "ProcessDefinition",
  "type": "object",
  "required": [
    "id",
    "steps"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string"
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classify": {
      "type": "boolean"
    },
    "classification": {
      "type": "object",
      "properties": {
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threshold": {
          "type": "number"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "onFail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "process": {
            "type": "string"
          },
          "role": {
            "enum": [
              "investigate",
              "implement",
              "review",
              "check"
            ]
          },
          "engine": {
            "enum": [
              "native",
              "worker"
            ]
          },
          "in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "out": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "number"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "onFail": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "retry_same",
                "retry_role",
                "block",
                "cancel_graph",
                "escalate"
              ]
            }
          },
          "goalTemplate": {
            "type": "string"
          }
        }
      }
    }
  }
}
