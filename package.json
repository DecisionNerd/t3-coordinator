{
  "name": "t3-coordinator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "t3-coordinator": "./lib/cli.js"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build.watch": "tsc --build --watch tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "ts-node src/dev.ts",
    "start.watch": "nodemon src/dev.ts",
    "worker": "ts-node src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "mcp": "ts-node src/mcp/server.ts",
    "cli": "ts-node src/cli.ts",
    "test": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' mocha --exit --timeout 30000 --require ts-node/register --require source-map-support/register 'src/mocha/*.{test.ts,test.cjs}'",
    "docs:dev": "npm run dev --prefix website",
    "docs:build": "npm run build --prefix website",
    "docs:preview": "npm run preview --prefix website"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@temporalio/activity": "^1.23.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/envconfig": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "nanoid": "3.x",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.23.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/mocha": "10.x",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "mocha": "12.x",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
